<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login — Shortly</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 24px;
      font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: linear-gradient(135deg, #f7f7ff, #eef2ff);
      color: #172033;
    }

    .box {
      width: min(420px, 100%);
      background: white;
      border: 1px solid #e7e9f0;
      border-radius: 20px;
      padding: 34px;
      box-shadow: 0 18px 55px rgba(30, 40, 80, 0.10);
    }

    .logo {
      font-size: 24px;
      font-weight: 800;
      text-decoration: none;
      color: #172033;
    }

    .logo span {
      color: #635bff;
    }

    h1 {
      margin: 30px 0 8px;
      font-size: 30px;
      letter-spacing: -0.8px;
    }

    .muted {
      margin: 0 0 25px;
      color: #667085;
      font-size: 14px;
    }

    label {
      display: block;
      font-size: 13px;
      font-weight: 700;
      margin: 17px 0 7px;
      color: #344054;
    }

    input {
      width: 100%;
      padding: 13px 14px;
      border: 1px solid #d9deea;
      border-radius: 10px;
      font-size: 15px;
      outline: none;
    }

    input:focus {
      border-color: #635bff;
      box-shadow: 0 0 0 3px rgba(99, 91, 255, 0.12);
    }

    button {
      width: 100%;
      margin-top: 24px;
      height: 46px;
      border: 0;
      border-radius: 10px;
      background: #635bff;
      color: white;
      font-weight: 700;
      font-size: 15px;
      cursor: pointer;
    }

    button:hover {
      background: #5148df;
    }

    .error {
      margin-top: 15px;
      padding: 11px 12px;
      border-radius: 9px;
      background: #fff1f2;
      color: #b42318;
      font-size: 13px;
    }

    .bottom {
      text-align: center;
      margin: 22px 0 0;
      color: #667085;
      font-size: 14px;
    }

    .bottom a {
      color: #635bff;
      font-weight: 700;
      text-decoration: none;
    }
  </style>
</head>

<body>

  <div class="box">

    <a class="logo" href="/">
      Short<span>ly</span>
    </a>

    <h1>Welcome back</h1>

    <p class="muted">
      Sign in to manage your shortened URLs.
    </p>

    <form action="/user/login" method="post">

      <label for="email">Email</label>

      <input
        id="email"
        type="email"
        required
        name="email"
        autocomplete="email"
        placeholder="you@example.com"
      >

      <label for="password">Password</label>

      <input
        id="password"
        type="password"
        required
        name="password"
        autocomplete="current-password"
        placeholder="Enter your password"
      >

      <button type="submit">
        Login
      </button>

    </form>

    <% if (locals.error) { %>
      <div class="error">
        <%= error %>
      </div>
    <% } %>

    <p class="bottom">
      Don't have an account?
      <a href="/signup">Create one</a>
    </p>

  </div>

</body>
</html>